# API Base URL
# For development with separate frontend/backend servers
VITE_API_BASE_URL=http://localhost:8000

# For production (FastAPI serving built Vite files)
# VITE_API_BASE_URL=

# CARTO Basemaps key (free: carto.com/basemaps/apikey). Put the real one in
# .env.local (gitignored); prod gets it from the CARTO_BASEMAPS_KEY GitHub secret.
# VITE_CARTO_BASEMAPS_KEY=
